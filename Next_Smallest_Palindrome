string addOne(string number) {
    int carry = 1;string addOne(string number) {
    int carry = 1;
    int n = number.length();
    while(n--) {
        int digit = number[n] - '0' + carry;
        carry = digit / 10;
        digit = digit % 10;
        number[n] = digit + '0';
    }
    if(carry) {
        number = '1' + number;
    }
    
    return number;
}

string solveForEven(string A) {
    string s1, s2;
    for(int i = 0; i < A.size(); i++) {
        if(i >= A.size()/2) s2 += A[i];
        else s1 += A[i];
    }
    string rev_s1 = s1;
    reverse(rev_s1.begin(), rev_s1.end());
    if(s2 < rev_s1) return s1 + rev_s1;
    else {
        string mod_s1 = addOne(s1);
        string mod_rev_s1 = mod_s1;
        reverse(mod_rev_s1.begin(), mod_rev_s1.end());
        
        return mod_s1 + mod_rev_s1;
    }
}

string solveForOdd(string A) {
    string s1, s2, s3;
    for(int i = 0; i < A.size(); i++) {
        if(i > A.size()/2) s3 += A[i];
        else{
            s1 += A[i];
            if(i != A.size()/2) s2 += A[i];
        }
    }
    string rev_s2 = s2;
    reverse(rev_s2.begin(), rev_s2.end());
    if(s3 < rev_s2) return s1 + rev_s2;
    else {
        string mod_s1 = addOne(s1), mod_rev_s1;
        for(int i = 0; i < mod_s1.size() - 1; i++) {
            mod_rev_s1 += mod_s1[i];
        }
        reverse(mod_rev_s1.begin(), mod_rev_s1.end());
        
        return mod_s1 + mod_rev_s1;
    }
}


